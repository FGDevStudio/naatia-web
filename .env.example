# No coloques credenciales reales en GitHub.
# Configurar exclusivamente en Vercel > proyecto naatia-web > Environment Variables
# Para enviar cotizaciones se requiere verificar el dominio del remitente en Resend:
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Opcionales: medición de campañas. No colocar IDs inventados.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
